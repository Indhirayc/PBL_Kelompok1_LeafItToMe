rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validPlant(d) {
      return d.nama_tanaman is string
        && d.nama_tanaman.size() > 0
        && d.nama_tanaman.size() <= 100
        && d.lokasi is string
        && d.status_kesehatan in ['sehat', 'perlu_perhatian', 'kritis']
        && d.tanggal_tanam is string;
    }

    // Field harus cocok dengan ScanRecordModel.toFirestore()
    // (lib/data/models/scan_record_model.dart)
    function validScan(d) {
      return d.id is string
        && d.user_id is string
        && d.plant_id is string
        && d.disease_name is string
        && d.disease_name.size() > 0
        && d.confidence is number
        && d.confidence >= 0
        && d.confidence <= 100
        && d.is_healthy is bool
        && d.scanned_at is timestamp
        && isOptionalString(d, 'plant_name')
        && isOptionalString(d, 'plant_location')
        && isOptionalString(d, 'latin_name')
        && isOptionalString(d, 'cloud_image_url')
        && isOptionalString(d, 'notes');
    }

    function isOptionalString(d, field) {
      return !(field in d)
        || d[field] is string
        || d[field] == null;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;

      match /plants/{plantId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validPlant(request.resource.data);
        allow update: if isOwner(uid)
          && validPlant(request.resource.data)
          && request.resource.data.created_at == resource.data.created_at;
        allow delete: if isOwner(uid);
      }

      match /scans/{scanId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validScan(request.resource.data);
        allow update: if isOwner(uid) && validScan(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /diseases/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /guides/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /tools/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}